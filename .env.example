# ─── Hagumi Environment Variables ───
# Copy this file to .env and fill in the values

# === Sentry (Error Tracking) ===
# Get DSN from: https://sentry.io/settings/<org>/projects/<project>/keys/
VITE_SENTRY_DSN=https://examplePublicKey@o123456.ingest.sentry.io/123456

# === Supabase (Database & Auth) ===
# Get from: https://supabase.com/dashboard/project/<project>/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# === API (Backend) ===
# Base URL for backend API (for future Go/Node services)
VITE_API_BASE_URL=http://localhost:3001/api/v1

# === AI Integration (Anthropic) ===
# Get your API key from: https://console.anthropic.com/
# Leave empty to use offline mock responses
VITE_ANTHROPIC_API_KEY=

# === App Info ===
VITE_APP_VERSION=0.1.0